{
  "name": "slides",
  "version": "0.1.0",
  "description": "Presentations as React code, built into one self-contained HTML file per deck.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANT1OFF/slides.git"
  },
  "homepage": "https://github.com/ANT1OFF/slides#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && node scripts/build.ts",
    "build:examples": "tsc --noEmit && node scripts/build-examples.ts",
    "new": "node scripts/new-deck.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "oxlint --type-aware",
    "check": "prettier --check . && npm run lint && node scripts/boundaries.ts && npm run build && node scripts/build-examples.ts --check",
    "verify": "node scripts/verify.ts",
    "pdf": "node scripts/pdf.ts",
    "refresh": "node scripts/refresh.ts",
    "upgrade": "node scripts/upgrade.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.2.0",
    "@oxlint/plugins": "1.95.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "magic-string": "^0.30.21",
    "oxlint": "1.95.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
